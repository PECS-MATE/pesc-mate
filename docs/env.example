# Copy/merge into the project-root .env; never commit real tokens.
# Remote Hugging Face inference: no local model or GPU required.
IMAGE_GENERATION_PROVIDER=gemini
IMAGE_GENERATION_DAILY_LIMIT=30
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=fal-ai

# Gemini API key stays on the backend. Issue from Google AI Studio.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional local background removal, independent from remote generation.
INSTALL_IMAGE_TOOLS=false
REMBG_MODEL_PATH=

# Optional Qwen profile in compose.yaml. Generate/listen to a synthetic reference first.
# QWEN_REFERENCE_DIR=./.local-voice-design/selected
# QWEN_BOY_REFERENCE_DIR=./.local-voice-design/selected-boy
# QWEN_CACHE_VERSION=qwen-selected-v1
# QWEN_DTYPE=bfloat16
# QWEN_BASE_REVISION=main

# Tablet access: set to 0.0.0.0 or the PC LAN IPv4, then start the selected app.
# TABLET_BIND_ADDRESS=0.0.0.0

# Optional trusted-LAN Wi-Fi RFID (not needed for USB).
# RFID_BIND_ADDRESS=0.0.0.0
# RFID_ALLOW_INSECURE_LAN=true

# Optional isolated secure services: docker compose --profile secure up -d backend-secure
# PESC_SECURE_SECRETS_DIR=C:/private/pesc-mate-secrets
# SECURE_MONGODB_DATABASE=pesc_mate_secure
