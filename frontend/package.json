    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "latest",
    "jsdom": "29.1.1",
    "vite": "latest",
    "vitest": "5.0.5"
  }
}
