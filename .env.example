# Copy/merge into the project-root .env; never commit real tokens.
# Remote Hugging Face inference: no local model or GPU required.
IMAGE_GENERATION_PROVIDER=huggingface
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=fal-ai

# Optional alternative; only used with IMAGE_GENERATION_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Optional local background removal, independent from remote generation.
INSTALL_IMAGE_TOOLS=false
REMBG_MODEL_PATH=
